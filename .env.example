OPENAI_API_KEY=your-key-here

# Optional. These limits protect your API budget when the app is public.
MAX_QUESTIONS_PER_SESSION=20
MAX_QUESTIONS_PER_DAY=300
MAX_UPLOADS_PER_SESSION=3
MAX_UPLOADS_PER_DAY=30

# Largest upload allowed, and the size above which the per-chunk LLM context step is skipped.
MAX_UPLOAD_TOKENS=500000
CONTEXT_TOKEN_LIMIT=40000

# How many visitors can hold an upload in memory at once. Raise this on a bigger host.
MAX_WORKSPACES=3
